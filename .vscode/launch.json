{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug active file (LLDB)",
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "ppp: build active file",
      "program": "${workspaceFolder}/build/debug/${relativeFileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "env": {
        // LeakSanitizer can't run under a debugger; the rest of ASan/UBSan still does.
        "ASAN_OPTIONS": "detect_leaks=0:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1",
        "ASAN_SYMBOLIZER_PATH": "/usr/lib/llvm-22/bin/llvm-symbolizer"
      }
    }
  ]
}
